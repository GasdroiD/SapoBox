{
  "manifest_version": 3,
  "name": "SapoBox: capturar links",
  "version": "2.0.0",
  "description": "Guarda os links de download numa lista. Você cola ou importa a lista no SapoBox.",
  "minimum_chrome_version": "102",
  "permissions": ["downloads", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capturar links para o SapoBox"
  }
}
